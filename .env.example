# Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail sending account. Use a 16-char App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords (requires 2FA enabled on the Google account)
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Where the daily digest email is sent
DIGEST_RECIPIENT=your_recipient_email@gmail.com
